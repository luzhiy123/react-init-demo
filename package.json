{
  "name": "vite-react-typescript-starter",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prebuild": "npm run build-router",
    "build": "vite build",
    "build-router": "ts-node router-config/build-script.ts",
    "predev": "npm run build-router",
    "dev": "vite",
    "format": "prettier --write .",
    "lint": "eslint src mock router-config *.config.ts",
    "lint:css": "stylelint \"**/*.{css,scss}\" --fix",
    "preview": "vite preview",
    "start": "concurrently \"npm run watch:router\" \"npm run dev\"",
    "watch:router": "nodemon --watch router-config --ext ts --exec \"npm run build-router\""
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@ant-design/pro-form": "^2.32.0",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "antd": "^5.29.3",
    "axios": "^1.13.6",
    "lodash": "^4.17.23",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "qs": "^6.15.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/lodash": "^4.17.24",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^14.0.0",
    "jiti": "^2.6.1",
    "less": "^4.6.4",
    "mockjs": "^1.1.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^2.5.22",
    "prettier-plugin-two-style-order": "^1.0.1",
    "sass": "^1.98.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^6.4.1",
    "vite-plugin-mock": "^3.0.2",
    "vite-plugin-style-import": "^2.0.0"
  }
}
