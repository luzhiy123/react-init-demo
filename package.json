{
  "name": "vite-react-typescript-starter",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prebuild": "npm run build-router",
    "build": "vite build",
    "build-router": "ts-node router-config/build-script.ts",
    "format": "prettier --write .",
    "lint": "eslint --ext .ts,.tsx src",
    "nodemon": "nodemon --watch router-config --ext ts --exec \"npm run build-router\"",
    "prettier": "prettier src",
    "preview": "vite preview",
    "prestart": "npm run build-router",
    "start": "concurrently \"npm run nodemon\"  vite  "
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@ant-design/pro-form": "^2.31.9",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "antd": "^5.26.0",
    "axios": "^1.10.0",
    "lodash": "^4.17.21",
    "mobx": "^6.13.7",
    "mobx-react-lite": "^4.1.0",
    "qs": "^6.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.17",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^24.0.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jiti": "^2.4.2",
    "less": "^4.3.0",
    "mockjs": "^1.1.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-packagejson": "^2.5.15",
    "prettier-plugin-two-style-order": "^1.0.1",
    "sass": "^1.89.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.3.5",
    "vite-plugin-mock": "^3.0.2",
    "vite-plugin-style-import": "^2.0.0"
  },
  "run": {
    "chokidar": "chokidar \"router-config/*.ts\" -c \"npm run build-router\""
  }
}
